# PostgreSQL connection string used by Prisma.
# Local development default (matches the local Postgres set up for this project):
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/e_sakhi?schema=public"

# Auth.js session secret (Part 03). Generate with: npx auth secret
AUTH_SECRET=

# OpenStreetMap-compatible tile endpoint for the map (Part 05).
NEXT_PUBLIC_MAP_TILE_URL="https://tile.openstreetmap.org/{z}/{x}/{y}.png"

# Public base URL of the app.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# One-time admin seed credentials (Part 03) - used only by the seed script,
# never by the public registration form.
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
