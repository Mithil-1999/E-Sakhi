# PostgreSQL connection string used by Prisma.
# Local development default (matches the local Postgres set up for this project):
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/e_sakhi?schema=public"

# Auth.js session secret (Part 03). Generate with: npx auth secret
AUTH_SECRET=

# OpenStreetMap-compatible tile endpoint for the map (Part 05).
NEXT_PUBLIC_MAP_TILE_URL="https://tile.openstreetmap.org/{z}/{x}/{y}.png"

# Public base URL of the app.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# One-time admin seed credentials - used only by scripts/create-admin.ts
# (npm run db:create-admin), never by the public registration form.
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
# Optional - ADMIN (default) or SUPER_ADMIN. Set to SUPER_ADMIN to create/
# promote the first Super Admin account (the only sanctioned way to get
# one - the in-app "Add User" form can only hand out Admin/Member).
# ADMIN_SEED_ROLE=SUPER_ADMIN

# Optional overrides for prisma/seed.ts and prisma/seed-coordinates.ts.
# Both already default to the committed files under prisma/seed-data/ —
# only set these if you need to seed from a different file path.
# EXCEL_DATA_PATH=
# COORDINATES_DATA_PATH=
